# Copy to .env and adjust. Every value below is optional: the defaults shown
# work for local development (Fake Store + Mailpit on localhost).
# Never commit .env.

# --- Backend HTTP ---
PORT=3000

# --- Product data source (Fake Store API) ---
FAKE_STORE_BASE_URL=https://fakestoreapi.com
# Abort a Fake Store request after this many milliseconds.
FAKE_STORE_TIMEOUT_MS=5000
# How long the in-memory product catalogue stays fresh (5 minutes).
PRODUCT_CACHE_TTL_MS=300000

# --- "Top rated" rules (see backend/src/products/top-rated.policy.ts) ---
# The 5 products the owner chose for the home page, in display order.
FEATURED_PRODUCT_IDS=1,5,9,13,17
# How many "top rated" products to show on a category page.
CATEGORY_TOP_RATED_COUNT=3

# --- Email (SMTP; Mailpit locally, UI at http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Leave blank for Mailpit. Set for a real SMTP relay (e.g. Amazon SES SMTP).
SMTP_USER=
SMTP_PASS=
# Sender address on enquiry emails.
ENQUIRY_FROM_EMAIL=catalogue@example.com
# Where enquiries are sent.
SALES_INBOX_EMAIL=sales@example.com
